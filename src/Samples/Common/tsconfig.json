{
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "jsx": "react",
    "target": "ESNext",
    "lib": [
      "dom",
      "ESNext"
    ]
  },
  "exclude": [
    "node_modules",
    "wwwroot"
  ]
}
