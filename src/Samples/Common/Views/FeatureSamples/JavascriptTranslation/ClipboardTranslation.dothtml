@viewModel DotVVM.Samples.Common.ViewModels.FeatureSamples.JavascriptTranslation.ClipboardTranslationViewModel, DotVVM.Samples.Common

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <title>Clipboard translation</title>
</head>
<body>
    <h1>Clipboard translation</h1>

    <p>
        <label for="text-to-copy">Text to copy:</label>
        <dot:TextBox ID="text-to-copy" data-ui="text-to-copy" Text="{value: TextToCopy}" />
    </p>
    <p>
        <label for="paste-target">Paste copied text here:</label>
        <input id="paste-target" data-ui="paste-target" />
    </p>

    <dot:Button data-ui="copy" Text="Copy to clipboard"
                Click="{staticCommand: _page.SetClipboardText(TextToCopy); ClipboardCopied = true}" />

    <p data-ui="clipboard-status">{{value: ClipboardCopied ? "Copied" : "Not copied"}}</p>
</body>
</html>
